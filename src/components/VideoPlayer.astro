---
import MainTitle from './MainTitle.astro';
import ButtonGoBack from './ButtonGoBack.astro';
import posterUrl from '@assets/img/video-poster/video-poster.jpg';
import Button from './Button.astro';
import { Icon } from 'astro-icon/components';
---

<section class="video section-offset">
  <div class="video__container container app-screen" data-container-video>
    <ButtonGoBack />
    <MainTitle title="Видео" />
    <div class="video__content">
      <div class="video__overlay" data-video-preview>
        <Button extraClass="video__btn">
          <Icon name="play" class="video__icon" />
          СМОТРЕТЬ РЕЛИЗ
        </Button>
      </div>

      <iframe
        class="video__iframe"
        data-vk-frame
        style="background-color: #000"
        src="https://vkvideo.ru/video_ext.php?oid=-45034028&id=456239017&hash=4f705c44cc48121e&hd=4&autoplay=0&js_api=1"
        allow="autoplay; encrypted-media; fullscreen; picture-in-picture; screen-wake-lock;"
        frameborder="0"
        allowfullscreen></iframe>
    </div>
  </div>
</section>
