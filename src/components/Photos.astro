---
import { dataImage } from '@data/images';
import type { PromoDataT } from '@appTypes/promoTypes';

import MainTitle from './MainTitle.astro';
import ButtonGoBack from './ButtonGoBack.astro';
import defaultImage from '@assets/img/no-photo.jpg';
import { Picture } from 'astro:assets';

interface Props {
  data: PromoDataT;
}

const { data } = Astro.props;
---

<section class="photos section-offset">
  <div class="photos__container container app-screen">
    <ButtonGoBack />
    <MainTitle title="Gallery" />
    <div class="swiper photos__swiper">
      <div class="swiper-wrapper">
        {
          data.photos && data.photos.length > 0 ? (
            data.photos.map((photo) => {
              const photoPath =
                dataImage[`/src/assets/${photo.src}.jpg`]?.default;
              const photoBand = photoPath || defaultImage;
              return (
                <div
                  class="swiper-slide photos__slide"
                  id={`photo-${photo.id}`}
                >
                  <div class="photos__card">
                    <Picture
                      src={photoBand}
                      formats={['webp']}
                      alt={photo.title}
                      widths={[600, 800]}
                      pictureAttributes={{ class: 'photos__picture-box' }}
                      class="photos__img"
                      loading="lazy"
                    />
                  </div>
                </div>
              );
            })
          ) : (
            <div class="swiper-slide">
              <p>Галерея пуста</p>
            </div>
          )
        }
      </div>

      <div class="photos__controls">
        <button
          class="swiper-button-prev photos__btn photos__btn--prev btn-reset"
          aria-label="Назад"></button>
        <div class="swiper-pagination photos__pagination"></div>
        <button
          class="swiper-button-next photos__btn photos__btn--next btn-reset"
          aria-label="Вперед"></button>
      </div>
    </div>
  </div>
</section>
